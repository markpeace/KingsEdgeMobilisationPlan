{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "King's Edge shared resource registry",
  "$defs": {
    "yearProfile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["academicYear", "fte"],
      "properties": {
        "academicYear": { "type": "string", "minLength": 1 },
        "fte": { "type": "number", "minimum": 0 },
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["deliverableId", "yearlyProfile"],
      "properties": {
        "deliverableId": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "yearlyProfile": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/yearProfile" }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["sharedResources"],
  "properties": {
    "sharedResources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "resourceType": { "type": "string" },
          "totalFte": { "type": "number", "minimum": 0 },
          "appointmentBasis": { "type": "string" },
          "employmentHome": { "type": "string" },
          "fundingBasis": { "type": "string" },
          "bauDestination": { "type": "string" },
          "yearlyProfile": {
            "type": "array",
            "items": { "$ref": "#/$defs/yearProfile" }
          },
          "allocationPlan": {
            "type": "array",
            "items": { "$ref": "#/$defs/allocation" }
          },
          "bauLiability": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "from": { "type": "string" },
              "fte": { "type": "number", "minimum": 0 },
              "annualAmount": { "type": "number", "minimum": 0 },
              "currency": { "type": "string" },
              "owner": { "type": "string" },
              "confidence": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
